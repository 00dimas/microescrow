{
  "name": "microescrow",
  "private": true,
  "scripts": {
    "compile": "XDG_CONFIG_HOME=.hardhat-local XDG_DATA_HOME=.hardhat-local XDG_CACHE_HOME=.hardhat-local hardhat compile",
    "test": "XDG_CONFIG_HOME=.hardhat-local XDG_DATA_HOME=.hardhat-local XDG_CACHE_HOME=.hardhat-local hardhat test",
    "coverage": "XDG_CONFIG_HOME=.hardhat-local XDG_DATA_HOME=.hardhat-local XDG_CACHE_HOME=.hardhat-local hardhat coverage",
    "deploy:sepolia": "XDG_CONFIG_HOME=.hardhat-local XDG_DATA_HOME=.hardhat-local XDG_CACHE_HOME=.hardhat-local hardhat ignition deploy ignition/modules/MicroEscrow.ts --network sepolia",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.13",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "dotenv": "^17.2.1",
    "hardhat": "^2.26.3",
    "solidity-coverage": "^0.8.16",
    "typescript": "^5.9.2"
  }
}
